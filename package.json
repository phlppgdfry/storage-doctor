{
  "name": "storage-doctor",
  "version": "0.3.0",
  "description": "Local object storage diagnostics with cross-protocol evidence reports",
  "type": "module",
  "license": "MIT",
  "bin": {
    "storage-doctor": "src/cli.js"
  },
  "exports": "./src/runner.js",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node src/cli.js check --local",
    "demo": "node scripts/demo.js",
    "demo:record": "node scripts/record-demo.js",
    "integration": "node scripts/integration.js",
    "verify": "npm run format:check && npm run check:syntax && npm run docs:check && npm test && npm run demo",
    "format": "prettier --write src test scripts docs README.md CONTRIBUTING.md SECURITY.md package.json .github action.yml CHANGELOG.md AGENTS.md",
    "format:check": "prettier --check src test scripts docs README.md CONTRIBUTING.md SECURITY.md package.json .github action.yml CHANGELOG.md AGENTS.md",
    "action:smoke": "node scripts/action-consumer-smoke.js",
    "package:offline": "node scripts/package-smoke.js --offline",
    "package:fresh": "node scripts/package-smoke.js --fresh",
    "package:smoke": "node scripts/package-smoke.js",
    "check:syntax": "node scripts/check-source.js",
    "docs:check": "node scripts/check-docs.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phlppgdfry/storage-doctor.git"
  },
  "homepage": "https://github.com/phlppgdfry/storage-doctor#readme",
  "bugs": {
    "url": "https://github.com/phlppgdfry/storage-doctor/issues"
  }
}
