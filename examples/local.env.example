# Supply values from your own local test stack. Do not commit real credentials.
SD_PROFILE=supabase
SD_REST_URL=http://127.0.0.1:55431/storage/v1
SD_S3_URL=http://127.0.0.1:55431/storage/v1/s3
SD_TUS_URL=http://127.0.0.1:55431/storage/v1/upload/resumable
SD_BUCKET=storage-doctor-test
SD_REGION=local
SD_TOKEN=replace-with-local-service-role-token
SD_API_KEY=replace-with-local-service-role-token
SD_ACCESS_KEY_ID=replace-with-local-s3-access-key
SD_SECRET_ACCESS_KEY=replace-with-local-s3-secret-key
SD_SEED=storage-doctor-v1
SD_TARGET_VERSION=replace-with-image-tag-or-commit
SD_TIMEOUT_MS=5000
# For a local S3-only engine set SD_PROFILE=s3 and SD_S3_URL to its endpoint.
# Cross-protocol scenarios will be reported as unsupported by that profile.
